# Copy to .env.local and fill in. Never commit .env.local.

# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Used by trusted server code (seeding, future POS webhook). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic API key for photo recognition (server only)
ANTHROPIC_API_KEY=sk-ant-...

# Square (optional; without these the site runs and skips syncing)
# Developer Dashboard > your app > Credentials. Use the Sandbox token for the demo.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Developer Dashboard > Webhooks > Subscriptions: subscribe to inventory.count.updated at <your site>/api/square/webhook
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://YOUR-SITE.vercel.app/api/square/webhook

# Protects the nightly Square check (/api/square/reconcile). Any long random string.
CRON_SECRET=
